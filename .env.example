# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or any file containing real secrets.
# Production values are configured in the hosting provider (e.g. Vercel),
# not in a committed file.

# --- Clerk authentication -------------------------------------------------
# Get these from the Clerk dashboard: https://dashboard.clerk.com
# The publishable key (NEXT_PUBLIC_*) is safe to expose in the browser.
# The secret key is server-side only and must be kept private.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/idea-hub
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/idea-hub

# --- Backend API ----------------------------------------------------------
# Base URL of the Wondr backend (FastAPI). Use the local port for development.
NEXT_PUBLIC_API_URL=http://localhost:8000
